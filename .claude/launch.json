{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "verilab",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "verilab-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "verilab-pages",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BASE_PATH=/verilab/",
        "npx",
        "vite",
        "preview",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174,
      "url": "http://localhost:4174"
    }
  ]
}